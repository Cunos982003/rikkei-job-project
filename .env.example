POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=rikkei_jobs

# MinIO — API cổng 9002, console cổng 9001
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# Redis (cổng 6379) và Mailpit (SMTP 1025 / UI 8025) không cần biến cấu hình.


# =============================================================================
# 2. Bí mật dùng chung
# =============================================================================
# JWT_SECRET — dùng bởi auth-service và recruitment-service (phải trùng nhau).
# Sinh khóa mới bằng:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_EXPIRATION_SECONDS=28800

# APP_JWT_SECRET — riêng của job-service.
APP_JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32


# =============================================================================
# 3. Tích hợp hệ thống ngoài (Mock server cổng 9000)
# =============================================================================
LMS_BASE_URL=http://localhost:9000
LMS_SERVICE_KEY=CHANGE_ME_LMS_SERVICE_KEY
LMS_VERIFY_ENDPOINT=/lms/sso/verify
LMS_TIMEOUT_SECONDS=5
LMS_MAX_RETRIES=2


# =============================================================================
# 4. Email (SMTP)
# =============================================================================
# auth-service đọc nhóm SPRING_MAIL_*; job-service và recruitment-service đọc
# nhóm MAIL_*/SMTP_*. Cả hai nhóm trỏ về cùng một máy chủ SMTP.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@rikkei-jobs.vn

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# false = chỉ ghi log ra console (MockEmailService); true = gửi email thật
EMAIL_ENABLED=false

# URL trong email đặt lại mật khẩu, trỏ về frontend
RESET_PASSWORD_URL=http://localhost:5173/reset-password


# =============================================================================
# 5. Địa chỉ các service nội bộ
# =============================================================================
JOB_SERVICE_URL=http://localhost:8085
PROFILE_SERVICE_URL=http://localhost:8082
JOB_DETAILS_PATH=/jobs/{jobId}
CV_PDF_PATH=/api/v1/cvs/{cvId}/pdf

# Tiền tố công khai để sinh link tuyệt đối (để trống = dùng đường dẫn tương đối)
PUBLIC_BASE_URL=

# recruitment-service: lưu và giới hạn tệp PDF của CV
CV_SNAPSHOT_DIRECTORY=uploads/recruitments
CV_MAX_PDF_BYTES=10485760

# CORS cho job-service (danh sách phân tách bằng dấu phẩy)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# =============================================================================
# 6. Database — ĐẶT RIÊNG CHO TỪNG SERVICE, KHÔNG ĐẶT Ở ĐÂY
# =============================================================================
# learning-service uses a dedicated URL; the remaining services can override
# SPRING_DATASOURCE_URL per process as described below.
LEARNING_DATABASE_URL=jdbc:postgresql://localhost:5432/learning_db

# Quy ước: mỗi service một database riêng tên <tên-service>_db. Danh sách đầy
# đủ nằm trong `infra/init-db/01-create-databases.sql` và được tạo tự động ở
# lần khởi tạo cluster đầu tiên.
#
# Các service đều đọc biến `SPRING_DATASOURCE_URL`, nhưng mỗi service cần một
# giá trị khác nhau. Một file .env chỉ giữ được MỘT giá trị cho mỗi tên biến,
# nên biến này phải export riêng cho từng tiến trình:
#
#   auth-service     SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db
#   profile-service  SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/profile_db
#   job-service      SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/job_db
#   recruitment-svc  SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/recruitment_db
#
# Ví dụ chạy cục bộ với profile-service:
#   export SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/profile_db
#   cd backend/profile-service && ./gradlew bootRun
#
# LƯU Ý: các service cần SPRING_DATASOURCE_PASSWORD trong .env. Riêng
# job-service cũng cần APP_JWT_SECRET; hoặc chạy bằng profile local dùng H2:
#   cd backend/job-service && ./gradlew bootRun --args='--spring.profiles.active=local'
#
# Tài khoản database dùng chung cho mọi service:
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Chỉ dùng khi chạy job-service ở profile `local` (H2 in-memory, không cần Postgres)
# SPRING_PROFILES_ACTIVE=local


# =============================================================================
# 7. ai_career_service (cổng 8090)
# =============================================================================
# provider: mock | openai | gemini | claude
# `mock` không gọi mạng — dùng cho dev/test, không cần API key.
AI_PROVIDER=mock

AI_OPENAI_API_KEY=
AI_OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_OPENAI_MODEL=gpt-4o-mini

AI_GEMINI_API_KEY=
AI_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

AI_CLAUDE_API_KEY=
AI_CLAUDE_ENDPOINT=https://api.anthropic.com/v1/messages
AI_CLAUDE_MODEL=claude-3-5-haiku-latest

# Để trống = dùng H2 in-memory
DATABASE_URL=jdbc:postgresql://localhost:5432/ai_career_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD


# =============================================================================
# 8. Frontend (Vite, cổng 5173)
# =============================================================================
# VITE_BACKEND_URL / VITE_AI_CAREER_URL: đích proxy phía server dev (vite.config.ts).
#   - Trỏ mock server:  http://localhost:9001
#   - Trỏ backend thật: http://localhost:8082
VITE_BACKEND_URL=http://localhost:9001
VITE_AI_CAREER_URL=http://localhost:8090

# VITE_API_BASE_URL / VITE_AI_CAREER_BASE_URL: tiền tố đường dẫn trong trình duyệt.
# Để trống thì dùng mặc định "/api/v1" và "/ai-career" (đi qua proxy của Vite).
VITE_API_BASE_URL=
VITE_AI_CAREER_BASE_URL=
AI_DATABASE_URL=jdbc:postgresql://localhost:5432/ai_db
AI_DATABASE_USERNAME=postgres
AI_DATABASE_PASSWORD=change-me
RECRUITMENT_DATABASE_URL=jdbc:postgresql://localhost:5432/recruitment_db
RECRUITMENT_DATABASE_USERNAME=postgres
RECRUITMENT_DATABASE_PASSWORD=change-me

# Must match the auth service signing key; replace before starting recruitment.
JWT_SECRET=replace-with-auth-service-signing-key
REDIS_USERNAME=
REDIS_PASSWORD=
SMTP_USERNAME=
SMTP_PASSWORD=
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
AI_CLAUDE_API_KEY=
