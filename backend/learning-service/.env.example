# ==============================================================================
# MẪU CẤU HÌNH MÔI TRƯỜNG DỊCH VỤ LEARNING-SERVICE (.env.example)
# Sao chép tệp này thành .env và điền thông tin phù hợp với môi trường của bạn
# ==============================================================================

# Cổng khởi chạy dịch vụ
SERVER_PORT=8089

# Cấu hình Cơ sở dữ liệu PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learning_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DRIVER=org.postgresql.Driver

# Mã khóa bảo mật JWT dùng chung
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Địa chỉ tích hợp các dịch vụ ngoài & Mock Server (Cổng 9000)
PROFILE_SERVICE_URL=http://localhost:8082
JOB_SERVICE_URL=http://localhost:9000
MOCK_SERVER_URL=http://localhost:9000

