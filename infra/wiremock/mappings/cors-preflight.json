{
  "priority": 1,
  "request": {
    "method": "OPTIONS",
    "urlPathPattern": "/.*"
  },
  "response": {
    "status": 200,
    "headers": {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Service-Key"
    }
  }
}